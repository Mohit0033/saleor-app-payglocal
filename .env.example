# ── PayGlocal (UAT by default) ────────────────────────────────────────────
# From the GCC control center. UAT keys are NOT valid in production.
PAYGLOCAL_MID=gldemomerchant
PAYGLOCAL_KID=REPLACE_WITH_PVT_KEY_KID
PAYGLOCAL_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# UAT sandbox; prod = https://api.payglocal.in
PAYGLOCAL_API_BASE=https://api.uat.payglocal.in

# Public base URL of this app (used for the PayGlocal merchantCallbackURL)
APP_URL=https://saleor-app-payglocal.example.com

# Where the buyer's browser is redirected after the hosted page
STOREFRONT_URL=https://shrijicrafts.com

# Optional: refuse webhooks from any other Saleor instance
ALLOWED_SALEOR_URL=

# Optional: where the transient transaction registry lives
# (default .payglocal-txn.json — must be on persistent storage, like APL)
PAYGLOCAL_TXN_STORE=
